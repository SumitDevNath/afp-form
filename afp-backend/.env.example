# AFP Backend - Local PostgreSQL Configuration

# PostgreSQL server
AFP_DB_HOST=127.0.0.1
AFP_DB_PORT=5432

# Development database
AFP_DB_NAME=afp_dev

# Supply actual credentials in the ignored .env file only
AFP_DB_USER=postgres
AFP_DB_PASSWORD=

# Explicit opt-in for loopback-only development HTTP endpoints
# Never enable in a production or publicly accessible environment.
AFP_LOCAL_API_ENABLED=false